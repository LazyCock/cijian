# Required in production
DATABASE_URL=postgres://qiongzhi:qiongzhi@127.0.0.1:5432/qiongzhi
REDIS_URL=redis://127.0.0.1:6379
AUTH_SECRET=replace-with-at-least-32-random-characters

# Local development without Postgres/Redis:
# Leave DATABASE_URL empty to use the embedded PGlite database in .data/pglite.
# Leave REDIS_URL empty to use the in-process cache/rate-limit fallback.
# AUTO_MIGRATE=false in production after running `pnpm db:migrate`.
AUTO_MIGRATE=true
SEED_DEMO=true

# Public origin, used for absolute links and cookie security decisions
APP_URL=http://localhost:3000
NODE_ENV=development
